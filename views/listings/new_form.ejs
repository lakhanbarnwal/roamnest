<% layout("/layouts/boilerplate") %>

    <body>
        <div class="row">
            <div class="col-8 offset-2">
                <h3 class="create-heading">Crete A New Listing</h3>
                <form action="/listings" method="POST" novalidate class="needs-validation" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label for="title" class="form-label"><b>Title</b></label>
                        <input type="text" name="title" placeholder="enter the title" class="form-control" required>
                        <div class="valid-feedback">
                            Looks good!
                        </div>
                        <div class="invalid-feedback">
                            enter a valid title
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="description" class="form-label"><b>Description</b></label>
                        <textarea type="textarea" name="description" placeholder="enter the description"
                            class="form-control" required></textarea>
                             <div class="valid-feedback">
                            Looks good!
                        </div>
                        <div class="invalid-feedback">
                            Enter a Description
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="image" class="form-label">Image</label>
                        <input type="file" name="image" placeholder="select an image" class="form-control">
                    </div>

                    <div class="mb-3">
                        <label for="price" class="form-label"><b>Price</b></label>
                        <input type="number" name="price" placeholder="enter the price" class="form-control" required>
                     <div class="valid-feedback">
                            Looks good!
                        </div>
                        <div class="invalid-feedback">
                           Enter the Price 
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="location" class="form-label"><b>Location</b></label>
                        <input type="text" name="location" placeholder="enter the location" class="form-control"
                            required>
                             <div class="valid-feedback">
                            Looks good!
                        </div>
                        <div class="invalid-feedback">
                            enter a valid location
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="country" class="form-label"><b>Country</b></label>
                        <input type="text" name="country" placeholder="enter the country" class="form-control" required>
                         <div class="valid-feedback">
                            Looks good!
                        </div>
                        <div class="invalid-feedback">
                            enter a valid country Name 
                        </div>
                    </div>

                        <button class="btn btn-black Add-btn ">ADD</button><br><br>
                </form>
            </div>
        </div>
    </body>