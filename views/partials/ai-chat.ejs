
<div id="rn-ai">
  <button id="rn-ai-toggle" type="button"
          aria-label="Open RoamNest AI assistant">
    ✦ <span>Ask RoamNest AI</span>
  </button>

  <section id="rn-ai-panel" hidden>
    <header class="rn-ai-header">
      <div>
        <strong>RoamNest AI</strong>
        <small>Search registered stays</small>
      </div>
      <button id="rn-ai-close" type="button"
              aria-label="Close chat">×</button>
    </header>

    <div id="rn-ai-messages" aria-live="polite">
      <div class="rn-ai-bubble rn-ai-bot">
        Hi! Ask me how many stays are registered
        in a city, or search by your budget.
      </div>
    </div>

    <form id="rn-ai-form">
      <input id="rn-ai-input" type="text"
             maxlength="500"
             placeholder="e.g. Hotels in Ranchi under ₹3000"
             autocomplete="off" required>
      <button id="rn-ai-send" type="submit">Send</button>
    </form>
    <p class="rn-ai-note">Results are from registered RoamNest listings.</p>
  </section>
</div>

<link rel="stylesheet" href="/css/ai-chat.css">
<script src="/js/ai-chat.js" defer></script>
